# --- dependencies
node_modules/
.pnpm-store/

# --- build output and caches
.next/
.next-*/
.turbo/
.cache/
.eslintcache
*.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/

# --- test output (Playwright, the screenshot tool, coverage)
test-results/
playwright-report/
blob-report/
coverage/

# --- logs
*.log
npm-debug.log*
pnpm-debug.log*

# --- local media, library and outputs (LIBRARY_DIR=./var/library, var/model-eval, var/*.log …)
var/

# --- evidence stays on the workstation (archived out of the repo 2026-10-06); only the files unit tests read are tracked
docs/evidence/**
!docs/evidence/**/
!docs/evidence/acceptance-v1/resume.json
!docs/evidence/model-eval-2026-10/llm/*/design-run*.json
!docs/evidence/model-eval-2026-10/voice-en/one-word/results.json
# the Phase 1 / Character A voice records (text only: metrics, readmes, the long line) — the clips stay local
!docs/evidence/phase1/*.json
!docs/evidence/character-a-voice/*.json
!docs/evidence/character-a-voice/**/*.json
!docs/evidence/character-a-voice/**/*.md
!docs/evidence/model-eval-2026-10/images-2512-bf16-phase1/*.json
!docs/evidence/model-eval-2026-10/images-2512-bf16-phase1/*.md

# --- generated media under docs/ is never committed (producer's rule, 2026-10-05); the reports beside it are.
# App samples (public/sample) and test fixtures (tests/fixtures) are tracked on purpose.
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.webp
docs/**/*.gif
docs/**/*.wav
docs/**/*.m4a
docs/**/*.mp3
docs/**/*.flac
docs/**/*.ogg
docs/**/*.mp4
docs/**/*.webm
docs/**/*.mov

# --- model weights live in the model store (VEWBOX_MODELS_ROOT), never in Git
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.onnx
*.bin
!tests/fixtures/**/*.bin

# --- local database dumps
*.dump
*.sql.gz
*.pgdump

# --- temp and editor files
*.tmp
*.temp
*.swp
*~
.DS_Store
Thumbs.db

# --- secrets: every env file except the documented example
.env
.env.*
!.env.example

# --- agent worktrees
.claude/worktrees/
