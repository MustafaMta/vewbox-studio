# generated media stays on the workstation, never in Git (producer's rule, 2026-10-05): evidence screenshots, generated
# images, voice and video under docs/ are written to disk only; the reports, JSON and HTML beside them are committed.
# App samples (public/sample) and test fixtures (tests/fixtures) are tracked on purpose.
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.webp
docs/**/*.gif
docs/**/*.wav
docs/**/*.m4a
docs/**/*.mp3
docs/**/*.flac
docs/**/*.ogg
docs/**/*.mp4
docs/**/*.webm
docs/**/*.mov

# Python bytecode (docker service tests)
__pycache__/
.pytest_cache/
