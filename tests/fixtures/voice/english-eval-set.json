  "document": "docs/research/MODEL-STACK-2026-10.md §5.7 (E1–E4) extended to twenty lines for the same harness (scripts/voice-eval.mjs, Latin-script lines are routed to IndexTTS)",
  "fields": { "text": "what the engine speaks", "gloss": "the same line (English needs no gloss)", "features": "what the line tests", "emotion": "the intended delivery", "sex": "M, F or ANY", "msaWouldSoundWrong": "always false (not an Arabic set)" },
  "lines": [
    { "id": "en-e1-calm", "category": "emotion", "text": "I told you we'd make it before the storm.", "gloss": "I told you we'd make it before the storm.", "features": ["contraction", "calm"], "emotion": "calm", "sex": "ANY", "msaWouldSoundWrong": false, "source": "model-stack §5.7 E1" },
    { "id": "en-e2-angry", "category": "emotion", "text": "I told you we'd make it before the storm!", "gloss": "the same line, angry", "features": ["contraction", "exclamation", "stress"], "emotion": "angry", "sex": "ANY", "msaWouldSoundWrong": false, "source": "model-stack §5.7 E2" },
    { "id": "en-e3-sad", "category": "emotion", "text": "Don't go. Please... not tonight.", "gloss": "Don't go. Please... not tonight.", "features": ["pause", "low-energy", "short-sentences"], "emotion": "sad", "sex": "ANY", "msaWouldSoundWrong": false, "source": "model-stack §5.7 E3" },
    { "id": "en-e4-monologue", "category": "long", "text": "When I was a boy my grandfather kept a radio on the workbench, and every night he would turn the dial until the static thinned into a voice. He said the sky was never silent; we had only forgotten how to listen to it.", "gloss": "a 12 s monologue", "features": ["long-sentence", "conversational-rhythm", "pause"], "emotion": "nostalgic", "sex": "ANY", "msaWouldSoundWrong": false, "source": "model-stack §5.7 E4 (written here)" },
    { "id": "en-q-01", "category": "question", "text": "Where were you at half past seven?", "gloss": "Where were you at half past seven?", "features": ["question-intonation", "time"], "emotion": "probing", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-q-02", "category": "question", "text": "You knew about the signal, didn't you?", "gloss": "You knew about the signal, didn't you?", "features": ["tag-question", "rising-tail"], "emotion": "probing", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-ex-01", "category": "exclamation", "text": "Look at that! It's still working!", "gloss": "Look at that! It's still working!", "features": ["exclamation", "stress", "contraction"], "emotion": "happy", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-num-01", "category": "numbers", "text": "The price is two hundred and fifty thousand dinars, not a dinar more.", "gloss": "numbers in words", "features": ["numbers-words", "firm"], "emotion": "firm", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-num-02", "category": "numbers", "text": "The appointment is at 7:30 on the 15th, and the price is 250 thousand.", "gloss": "the one line with digits (IndexTTS normalises English itself)", "features": ["digits-raw", "time", "date"], "emotion": "neutral", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-name-01", "category": "names", "text": "Abu Salam said he would come after the afternoon prayer, and Umm Hussein is waiting in Adhamiya.", "gloss": "Iraqi names and a Baghdad place in English speech", "features": ["foreign-name", "place-baghdad"], "emotion": "neutral", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-name-02", "category": "names", "text": "The Mariner vanished in eighty-seven. Nobody heard from her again.", "gloss": "a ship's name, a year", "features": ["name", "year", "low"], "emotion": "low", "sex": "ANY", "msaWouldSoundWrong": false, "source": "The Static Sky, Najm's line (paraphrase)" },
    { "id": "en-whisper-01", "category": "emotion", "text": "Listen... there's something moving behind the door. Don't open it.", "gloss": "a whisper", "features": ["pause", "whisper-register"], "emotion": "afraid", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored (twin of emo-fear-01)" },
    { "id": "en-tired-01", "category": "emotion", "text": "Honestly, there's nothing wrong. I'm just a little tired.", "gloss": "tired", "features": ["low-energy", "contraction"], "emotion": "tired", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored (twin of emo-tired-01)" },
    { "id": "en-humour-01", "category": "emotion", "text": "I told him to see a doctor. He said the doctor is the one who needs him.", "gloss": "comic timing", "features": ["reported-speech", "comic-timing"], "emotion": "humour", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored (twin of emo-humour-02)" },
    { "id": "en-tender-01", "category": "emotion", "text": "Don't be afraid, my dear. I'm here. I'm not leaving.", "gloss": "tender", "features": ["endearment", "short-sentences"], "emotion": "tender", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored (twin of emo-tender-01)" },
    { "id": "en-short-01", "category": "short", "text": "Nothing.", "gloss": "one word, falling", "features": ["one-word", "falling-intonation"], "emotion": "flat", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-short-02", "category": "short", "text": "Now?", "gloss": "one word, rising", "features": ["one-word", "question-intonation"], "emotion": "surprised", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored" },
    { "id": "en-film-01", "category": "film", "text": "Obsolescence. Always obsolescence.", "gloss": "Elias, muttering at the radio", "features": ["muttering", "repetition"], "emotion": "muttering", "sex": "M", "msaWouldSoundWrong": false, "source": "The Static Sky line-2e2e6225ef" },
    { "id": "en-film-02", "category": "film", "text": "Static's just a story waiting to be told.", "gloss": "Elias", "features": ["contraction", "warmth"], "emotion": "nostalgic", "sex": "M", "msaWouldSoundWrong": false, "source": "The Static Sky line-bc1475218a" },
    { "id": "en-long-02", "category": "long", "text": "This morning I left the house early; the whole street was quiet, only the vendors' voices and the smell of bread from the bakery, and I felt as if the city were breathing with me.", "gloss": "one breath, pauses at the commas", "features": ["long-sentence", "conversational-rhythm"], "emotion": "calm", "sex": "ANY", "msaWouldSoundWrong": false, "source": "authored (twin of long-02)" }
  ]
}
