{
  "name": "vewbox-studio",
  "private": true,
  "version": "16.0.0",
  "description": "Vewbox Studio — an AI filmmaking studio: shows, shorts and music videos, with MiniMax video, local images, voices and transcription on one RTX 5090.",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/serve.ts dev",
    "build": "next build",
    "start": "tsx scripts/serve.ts start",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:server": "tsx scripts/test-server.ts",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/cli.ts migrate",
    "db:studio": "drizzle-kit studio",
    "sample-media": "node tools/sample-media.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
