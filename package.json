{
  "name": "vewbox-studio",
  "private": true,
  "version": "15.0.0",
  "description": "Vewbox Studio — the filmmaking studio's interface, as a frontend-only prototype on local sample data.",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "next build",
    "start": "next start -p 4200",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "tsx tools/shots.ts",
    "sample-media": "node tools/sample-media.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
