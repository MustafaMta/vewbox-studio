# Vewbox Studio — environment. Copy to .env and fill in what you have. Never commit .env.

# --- Database (the compose file creates this user and database) ---
POSTGRES_USER=vewbox
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=vewbox
DATABASE_URL=postgres://vewbox:change-me-please@db:5432/vewbox

# --- Access ---
# Leave empty to run the studio open on this machine; set a password to gate every page and the API.
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=

# --- MiniMax (the only video provider; also text and speech when configured) ---
# Create a key at https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_MUSIC_MODEL=music-3.0

# --- Video backend: auto = hosted MiniMax API when a key is set, otherwise the local open-weights MiniMax H3 in ComfyUI ---
VIDEO_BACKEND=auto

# --- Story engine (writing): auto picks minimax > anthropic > openai-compatible, whichever is configured ---
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible server, e.g. the bundled Ollama: http://llm:11434/v1 with model qwen3:14b
OPENAI_COMPATIBLE_BASE_URL=http://llm:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=qwen3:14b

# --- Local GPU services (compose service names) ---
COMFYUI_URL=http://comfyui:8188
TTS_URL=http://tts:8020
ASR_URL=http://asr:8030

# --- Worker tuning ---
WORKER_CONCURRENCY_HOSTED=4
WORKER_CONCURRENCY_LLM=2
WORKER_CONCURRENCY_CPU=2
GPU_VRAM_BUDGET_MB=30000

# --- Public origin (only needed when MiniMax must fetch files from this server; local files are sent inline otherwise) ---
PUBLIC_BASE_URL=

# --- Storage on the host (bind mounts) ---
MODELS_DIR=./var/models
LIBRARY_DIR=./var/library

LOG_LEVEL=info
LOG_PRETTY=0
