# Vewbox Studio — environment. Copy to .env and fill in what you have. Never commit .env.
# Every value here has a working default for a single machine; the only secret you may need is MINIMAX_API_KEY.

# --- Database (the compose file creates this user and database; the port is published on 127.0.0.1 only) ---
POSTGRES_USER=vewbox
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=vewbox
DATABASE_URL=postgres://vewbox:change-me-please@db:5432/vewbox
DB_PORT=5432

# --- Access ---
# The studio listens on 127.0.0.1 only. Set a password and every page and API call requires it (HTTP Basic).
STUDIO_PASSWORD=
# LAN access is opt-in and needs STUDIO_PASSWORD: STUDIO_BIND for `pnpm dev`/`pnpm start` on the host, WEB_BIND for
# the compose stack (e.g. 0.0.0.0). STUDIO_ALLOW_OPEN_LAN=1 accepts an open studio on a trusted network anyway.
# STUDIO_BIND=127.0.0.1
# WEB_BIND=127.0.0.1
# STUDIO_ALLOW_OPEN_LAN=
# Rollback for one release: 1 lets pages send worker-only (system) commands again (POST /api/commands).
# STUDIO_LEGACY_COMMANDS=
# Rollback for one release: off lets a gate (story → produce, cut → export) open on an approval whose subject has
# changed since (approvals are bound to the hash of what was approved).
# APPROVAL_BINDING=
# Rollback for one release: v1 loads and saves the WHOLE studio under one lock for every command batch (before step 13
# each batch loaded and saved only the aggregates it touches, with per-aggregate locks and version compare-and-set).
# STUDIO_STORE=

# --- MiniMax (the only video provider; also text, speech and music when configured) ---
# Create a key at https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_MUSIC_MODEL=music-3.0

# --- Video backend: auto = hosted MiniMax API when a key is set, otherwise the local open-weights MiniMax H3 in ComfyUI ---
VIDEO_BACKEND=auto

# --- Music engine: auto = MiniMax Music API when a key is set, else ACE-Step 1.5 (local), else MiniMax Music 3 (local) ---
# MUSIC_ENGINE=ace-step | minimax-music3 | minimax-api
MUSIC_ENGINE=auto
# ACE-Step 1.5 XL variant: auto = XL-SFT + the 5Hz LM 4B when installed (group music-ace-step-xl), else XL turbo with a
# warning; xl-sft = refuse without it; xl-turbo = a quick draft
MUSIC_ACE_VARIANT=auto

# --- Story engine (writing): auto picks minimax > anthropic > openai-compatible, whichever is configured ---
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# The production planner: Qwen3.8-27B-FP8 (the official Qwen/Qwen3.8-27B-FP8, Apache-2.0; manifest group
# llm-qwen3.8-27b-fp8 → <store>/llm/qwen3.8-27b-fp8) on vLLM, compose service llm-vllm (host port VLLM_PORT, 8050).
# docs/research/MODEL-EVAL-2026-10.md §12. The host worker/web reach it at http://127.0.0.1:8050/v1 (.env.local).
# Thinking is off on every call unless a stage asks for it (reasoning). The GPU lease puts vLLM to sleep (level 2)
# when another family takes the card and wakes it for the next story job.
# ROLLBACK ONLY (Qwen3.6-27B Q8_0 on Ollama, weights kept in the store until the producer approves removal):
# OPENAI_COMPATIBLE_BASE_URL=http://llm:11434/v1, OPENAI_COMPATIBLE_RUNTIME=ollama, OPENAI_COMPATIBLE_MODEL=qwen3.6:27b-q8_0;
# stop llm-vllm, then `docker compose --profile fallback up -d llm`.
OPENAI_COMPATIBLE_BASE_URL=http://llm-vllm:8000/v1
OPENAI_COMPATIBLE_API_KEY=local
OPENAI_COMPATIBLE_MODEL=Qwen3.8-27B-FP8
# vllm | ollama | remote (empty = from the URL)
OPENAI_COMPATIBLE_RUNTIME=vllm
# The planner's context window, prompt + answer (vLLM --max-model-len; the app budgets answers inside it)
LLM_CONTEXT_LENGTH=16384
VLLM_PORT=8050
# The share of the card vLLM may take (weights + cache); the image itself is pinned by digest in compose.yaml
VLLM_GPU_MEMORY_UTILIZATION=0.96
# What llm-pull fetches for the Ollama rollback (comma separated Ollama tags)
OLLAMA_PULL_MODELS=qwen3.6:27b-q8_0
# How long Ollama keeps a model loaded after a request (the GPU lease unloads it earlier when another family needs the card)
OLLAMA_KEEP_ALIVE=2m
# Context window: the llm service's default and what the app sends as num_ctx. 16384 keeps Qwen3.6-27B Q8_0 (28.4 GB) and
# its q8_0 KV cache (544 MB: only 16 of its 64 layers attend) on the 32 GB card at ≈ 31.5 GB; do not raise it for this
# model — there is no room left (Gemma 4 31B QAT: 21.4 GB at 16384). Ollama offloads layers to the CPU beyond the card.
OLLAMA_CONTEXT_LENGTH=16384
# Flash attention and a quantised KV cache (q8_0 halves it against f16; f16 keeps the exact cache)
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# --- Local GPU services (compose service names; host ports are published on 127.0.0.1 for debugging) ---
COMFYUI_URL=http://comfyui:8188
TTS_URL=http://tts:8020
TTS_HABIBI_URL=http://tts-habibi:8021
# Voice design (VoxCPM2) + ECAPA speaker embeddings. A worker on the host uses http://127.0.0.1:8022 (put that in .env.local)
TTS_DESIGN_URL=http://tts-design:8022
ASR_URL=http://asr:8030
COMFYUI_PORT=8188
TTS_PORT=8020
TTS_HABIBI_PORT=8021
TTS_DESIGN_PORT=8022
# Where the design service runs its ECAPA speaker encoder (cpu is enough: 20 M parameters)
TTS_DESIGN_ECAPA_DEVICE=cpu
ASR_PORT=8030
# Transcription models in the model store (paths inside the asr container). ASR_MODEL_DIR serves every language;
# ASR_MODEL_DIR_AR serves `language=ar` when its model.bin exists (the CTranslate2 copy of whisper-large-v3-arabic-
# dialectal-v2 written by `docker compose --profile models run --rm asr-convert` after fetching group stack-2026-10).
# Empty ASR_MODEL_DIR_AR = Arabic stays on large-v3. One Whisper model is on the card at a time.
# ASR_MODEL_DIR=/models/asr/faster-whisper-large-v3
# ASR_MODEL_DIR_AR=/models/asr/whisper-large-v3-arabic-dialectal-v2-ct2
OLLAMA_PORT=11434
# VRAM ComfyUI keeps free for other work (GB)
COMFY_RESERVE_VRAM=1.0

# --- Model weights ---
# THE MODEL STORE (docs/MODELS-STORAGE.md): every weight lives in one ext4 VHDX on D:, attached to the WSL VM (no admin):
#   wsl --mount --vhd D:\models\vewbox-models.vhdx --name models
# VEWBOX_MODELS_ROOT is that disk as Docker's engine sees it; every model path in compose derives from it (the `models`
# and `ollama` volumes are binds of it). It must be /run/desktop/mnt/host/wsl/<name>: /mnt/wsl/<name> is NOT visible to
# Docker Desktop's engine. The mount name is the last path segment. scripts/resume-local.mjs and docker-watchdog attach
# VEWBOX_MODELS_VHDX when the store's marker (.vewbox-models) is missing.
VEWBOX_MODELS_ROOT=/run/desktop/mnt/host/wsl/models
VEWBOX_MODELS_VHDX=D:\models\vewbox-models.vhdx
# Groups the fetcher downloads (docker compose --profile models run --rm models); see docker/models/manifest.json.
# Outside the default: stack-2026-10 (the Iraqi Whisper, 6.2 GB; then run asr-convert) and images-vlm, images-qwen-identity.
# Compose reads this variable when it parses the file (`run -e MODEL_GROUPS=` has no effect); one group on the command
# line: docker compose --profile models run --rm models --manifest manifest.json --root /models --groups stack-2026-10
MODEL_GROUPS=video-minimax-h3,images-qwen,asr-whisper,music-ace-step,video-minimax-h3-reference,music-minimax-3,voice-design
# Optional Hugging Face token (faster downloads, gated repos)
HF_TOKEN=
HF_HUB_DISABLE_XET=1

# --- Worker tuning ---
WORKER_CONCURRENCY_HOSTED=4
WORKER_CONCURRENCY_LLM=2
WORKER_CONCURRENCY_CPU=2
GPU_VRAM_BUDGET_MB=32000
# The GPU lease is shared by every process through the database (resource_leases, FIFO). Rollback for one release:
# GPU_LEASE_DATABASE_URL: the ONE database the GPU lease lives in for this machine. Default: the live studio database
# (vewbox) on DATABASE_URL's server, whatever database the process uses - a server or worker on a copy database queues
# on the live lease like the studio. A process whose lease is not the live one is refused the machine's real engines.
# The test suites set it to their own test database (and use fixture engines: VEWBOX_FIXTURE_ENGINES=1).
# GPU_LEASE_DATABASE_URL=
# GPU_LEASE=memory gives each process its own in-memory lease again.
# GPU_LEASE=

# --- Web ---
WEB_PORT=4200
MAX_UPLOAD_MB=2048
# Only needed when MiniMax must fetch files from this server; local files are sent inline otherwise
PUBLIC_BASE_URL=

# --- Storage on the host ---
# Generated and uploaded media (bind mount). Model weights live in the `models` named volume.
LIBRARY_DIR=./var/library

# --- Tests only ---
# 1 lets POST /api/studio/reset {"kind":"sample"} load the sample studio (the browser and API tests' fixture).
# Leave it unset on a real studio: it starts empty and has no way back to the sample.
# STUDIO_SAMPLE_FIXTURE=1
# 1 enables POST /api/studio/reset (empty or reload the studio). Honoured ONLY on a database that is not the live
# `vewbox` (src/server/test-guard.ts); library files are deleted only in a folder marked `.vewbox-test-library`.
# Never set it on the producer's studio: `pnpm test:server` sets it for its own isolated database.
# VEWBOX_ALLOW_RESET=1
# The database the worker/API/browser suites use; default: DATABASE_URL with the database renamed to vewbox_test.
# TEST_DATABASE_URL=postgres://vewbox:change-me-please@127.0.0.1:5432/vewbox_test

# --- Logging / build ---
LOG_LEVEL=info
LOG_PRETTY=0
CODE_VERSION=dev

# --- Trend research for Auto Idea (optional; docs/CONTRACTS-AUTO-IDEA.md). Without these, the platforms are reported
# as NOT_CONFIGURED in every research run; Facebook has no permitted public API (UNSUPPORTED). Never commit values.
# YOUTUBE_API_KEY=
# TIKTOK_RESEARCH_CLIENT_KEY=
# TIKTOK_RESEARCH_CLIENT_SECRET=
# INSTAGRAM_GRAPH_TOKEN=
# INSTAGRAM_BUSINESS_ID=
# RESEARCH_CONTACT=          # optional contact address sent in the User-Agent of research requests