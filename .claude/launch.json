{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 4200
    },
    {
      "name": "studio-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "--env-file=.env", "--env-file=.env.local", "src/worker/index.ts"],
      "port": 4299
    },
    {
      "name": "studio-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "next",
        "start",
        "-p",
        "4210"
      ],
      "port": 4210
    }
  ]
}
